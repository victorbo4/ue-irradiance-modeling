# --------------------
# Unreal Engine
# --------------------
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
.vscode/

# Ignore config files that are user-specific
*.user
*.userprefs
*.suo
*.sln.docstates

# Ignore project-specific VS files
.vs/
*.VC.db
*.VC.opendb
*.opensdf

# Compiled source
*.dll
*.exe
*.lib
*.app
*.dylib
*.obj
*.o
*.pdb

# Ignore macOS and Linux system files
.DS_Store
*.swp
*.tmp

# Crash reports
*.log
*.dmp

# Generated docs (regenerate: doxygen Doxyfile from simulation/Plugins/Pyrano/)
simulation/Docs/html/
simulation/Docs/latex/

# Editor / tooling generated
.ignore
*.code-workspace
compile_commands.json
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Ignore Python cache
__pycache__/
*.py[cod]

# Ignore any auto-generated folders by Epic
Saved/
DerivedDataCache/

# Optional: Ignore build tool files
*.xcodeproj
*.xcworkspace
*.sln

# Optional: Ignore specific files generated by VS
VSWorkspaceState.json
projectsettings.json
